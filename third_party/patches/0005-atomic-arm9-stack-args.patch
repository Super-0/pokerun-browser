+  u32 WasmEmulator::callArm9Thumb8Atomic(u32 function, u32 r0, u32 r1, u32 r2, u32 r3,
+                                         u32 r4stack, u32 r5stack, u32 r6stack, u32 r7stack,
+                                         u32 stackReserve) {
+    // Deterministic native-call bridge for ABI calls that need stack arguments.
+    // The first four arguments use r0-r3. Arguments 5-8 are written at the
+    // callee entry SP as required by AAPCS. Unlike callArm9Thumb4's PRK9
+    // scheduler-aware path, this bridge advances ARM9 only; it is intended for
+    // short synchronous game helpers such as window/list construction pieces.
+    pokerunArm9CallStatus = 0;
+    pokerunArm9CallPc = 0;
+    pokerunArm9CallLr = 0;
+    pokerunArm9CallCpsr = 0;
+    pokerunArm9CallInstructions = 0;
+
+    const u32 functionBase = function & ~1u;
+    if (functionBase < 0x02000000 || functionBase >= 0x02400000 ||
+        stackReserve < 0x100 || stackReserve > 0x4000 || (stackReserve & 0x7)) {
+      pokerunArm9CallStatus = 2;
+      return 0;
+    }
+
+    ARMv5& arm = nds->ARM9;
+    const u32 originalSp = arm.R[13];
+    constexpr u32 stackArgBytes = 16;
+    if (originalSp < stackReserve || originalSp > 0xfffffff0u) {
+      pokerunArm9CallStatus = 2;
+      return 0;
+    }
+    const u32 stackBase = originalSp - stackReserve;
+    const u32 backupSize = stackReserve + stackArgBytes;
+    std::vector<u8> stackBackup(backupSize);
+    for (u32 i = 0; i < backupSize; i++) stackBackup[i] = nds->ARM9Read8(stackBase + i);
+
+    u32 savedR[16];
+    u32 savedRFIQ[8];
+    u32 savedRSVC[3];
+    u32 savedRABT[3];
+    u32 savedRIRQ[3];
+    u32 savedRUND[3];
+    std::memcpy(savedR, arm.R, sizeof(savedR));
+    std::memcpy(savedRFIQ, arm.R_FIQ, sizeof(savedRFIQ));
+    std::memcpy(savedRSVC, arm.R_SVC, sizeof(savedRSVC));
+    std::memcpy(savedRABT, arm.R_ABT, sizeof(savedRABT));
+    std::memcpy(savedRIRQ, arm.R_IRQ, sizeof(savedRIRQ));
+    std::memcpy(savedRUND, arm.R_UND, sizeof(savedRUND));
+    const u32 savedCPSR = arm.CPSR;
+    const s32 savedCycles = arm.Cycles;
+    const u32 savedStopExecution = arm.StopExecution;
+    const u32 savedCodeRegion = arm.CodeRegion;
+    const s32 savedCodeCycles = arm.CodeCycles;
+    const u32 savedDataRegion = arm.DataRegion;
+    const s32 savedDataCycles = arm.DataCycles;
+    const u32 savedCurInstr = arm.CurInstr;
+    const u32 savedNextInstr0 = arm.NextInstr[0];
+    const u32 savedNextInstr1 = arm.NextInstr[1];
+    const MemRegion savedCodeMem = arm.CodeMem;
+    const s32 savedRegionCodeCycles = arm.RegionCodeCycles;
+    u8* const savedPUMap = arm.PU_Map;
+    const u64 savedTimestamp = nds->ARM9Timestamp;
+    const u64 savedTarget = nds->ARM9Target;
+    const int savedCurCPU = nds->CurCPU;
+    const u32 savedPokerunStopAddress = arm.PokerunStopAddress;
+    const u32 savedPokerunExecutedInstructions = arm.PokerunExecutedInstructions;
+    const u32 savedPokerunInstructionLimit = arm.PokerunInstructionLimit;
+    const bool savedPokerunStopHit = arm.PokerunStopHit;
+    const bool savedPokerunBudgetExceeded = arm.PokerunBudgetExceeded;
+
+    const bool returnThumb = (savedCPSR & 0x20) != 0;
+    const u32 returnAddress = (savedR[15] - (returnThumb ? 2u : 4u)) & (returnThumb ? ~1u : ~3u);
+
+    // Stack arguments are at SP+0, +4, +8, +12 on function entry. Backing up
+    // those 16 bytes above the interrupted SP lets us restore the game exactly.
+    nds->ARM9Write32(originalSp + 0, r4stack);
+    nds->ARM9Write32(originalSp + 4, r5stack);
+    nds->ARM9Write32(originalSp + 8, r6stack);
+    nds->ARM9Write32(originalSp + 12, r7stack);
+
+    nds->CurCPU = 0;
+    arm.StopExecution = 0;
+    arm.Cycles = 0;
+    arm.PokerunStopAddress = 0;
+    arm.PokerunExecutedInstructions = 0;
+    arm.PokerunInstructionLimit = 0;
+    arm.PokerunStopHit = false;
+    arm.PokerunBudgetExceeded = false;
+    arm.R[0] = r0;
+    arm.R[1] = r1;
+    arm.R[2] = r2;
+    arm.R[3] = r3;
+    arm.R[13] = originalSp;
+    arm.R[14] = returnAddress | (returnThumb ? 1u : 0u);
+    arm.JumpTo(functionBase | 1u, false);
+
+    bool returned = false;
+    u32 executedInstructions = 0;
+    constexpr u32 maxInstructions = 1000000;
+    for (u32 instruction = 0; instruction < maxInstructions; instruction++) {
+      const bool thumb = (arm.CPSR & 0x20) != 0;
+      const u32 currentAddress = (arm.R[15] - (thumb ? 2u : 4u)) & (thumb ? ~1u : ~3u);
+      if (currentAddress == returnAddress) {
+        returned = true;
+        break;
+      }
+      if (arm.Halted) {
+        pokerunArm9CallStatus = 4;
+        break;
+      }
+      nds->ARM9Target = nds->ARM9Timestamp + 1;
+      arm.PokerunExecuteInterpreterStep();
+      executedInstructions++;
+    }
+
+    const bool finalThumb = (arm.CPSR & 0x20) != 0;
+    pokerunArm9CallPc = (arm.R[15] - (finalThumb ? 2u : 4u)) & (finalThumb ? ~1u : ~3u);
+    pokerunArm9CallLr = arm.R[14];
+    pokerunArm9CallCpsr = arm.CPSR;
+    pokerunArm9CallInstructions = executedInstructions;
+    const u32 result = arm.R[0];
+    if (returned) pokerunArm9CallStatus = 1;
+    else if (pokerunArm9CallStatus == 0) pokerunArm9CallStatus = 3;
+
+    for (u32 i = 0; i < backupSize; i++) nds->ARM9Write8(stackBase + i, stackBackup[i]);
+    std::memcpy(arm.R, savedR, sizeof(savedR));
+    std::memcpy(arm.R_FIQ, savedRFIQ, sizeof(savedRFIQ));
+    std::memcpy(arm.R_SVC, savedRSVC, sizeof(savedRSVC));
+    std::memcpy(arm.R_ABT, savedRABT, sizeof(savedRABT));
+    std::memcpy(arm.R_IRQ, savedRIRQ, sizeof(savedRIRQ));
+    std::memcpy(arm.R_UND, savedRUND, sizeof(savedRUND));
+    arm.CPSR = savedCPSR;
+    arm.Cycles = savedCycles;
+    arm.StopExecution = savedStopExecution;
+    arm.CodeRegion = savedCodeRegion;
+    arm.CodeCycles = savedCodeCycles;
+    arm.DataRegion = savedDataRegion;
+    arm.DataCycles = savedDataCycles;
+    arm.CurInstr = savedCurInstr;
+    arm.NextInstr[0] = savedNextInstr0;
+    arm.NextInstr[1] = savedNextInstr1;
+    arm.CodeMem = savedCodeMem;
+    arm.RegionCodeCycles = savedRegionCodeCycles;
+    arm.PU_Map = savedPUMap;
+    arm.PokerunStopAddress = savedPokerunStopAddress;
+    arm.PokerunExecutedInstructions = savedPokerunExecutedInstructions;
+    arm.PokerunInstructionLimit = savedPokerunInstructionLimit;
+    arm.PokerunStopHit = savedPokerunStopHit;
+    arm.PokerunBudgetExceeded = savedPokerunBudgetExceeded;
+    nds->ARM9Timestamp = savedTimestamp;
+    nds->ARM9Target = savedTarget;
+    nds->CurCPU = savedCurCPU;
+
+    return returned ? result : 0;
+  }
+
   u32 WasmEmulator::pokerunRuntimeVersion() {
-    return 0x50524B39;
+    return 0x50524B3A;
   }
