{
  "name": "pokerun-browser",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-mgba-heap.mjs && vite",
    "dev:multiplayer": "node scripts/patch-mgba-heap.mjs && node scripts/dev-multiplayer.mjs",
    "white2:extract": "node tools/white2-extract/run-all.mjs",
    "white2:runtime-boundaries": "node tools/white2-extract/runtime-boundary-export.mjs",
    "build:melonds": "node scripts/build-melonds.mjs",
    "build": "node scripts/patch-mgba-heap.mjs && tsc -b && vite build",
    "preview": "node scripts/patch-mgba-heap.mjs && vite preview",
    "postinstall": "node scripts/patch-mgba-heap.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run test:unit && npm run build && npm run test:browser",
    "test:integration": "playwright test --grep @integration",
    "test:smoke": "playwright test --grep-invert @integration",
    "test:native": "node scripts/test-white2-private.mjs runtime",
    "test:white2:prepare": "node scripts/test-white2-private.mjs prepare",
    "test:white2": "node scripts/test-white2-private.mjs greeting",
    "test:white2:local-trade": "node scripts/test-white2-local-trade.mjs",
    "test:native:schedule": "node scripts/test-white2-private.mjs schedule",
    "test:white2:streak": "node scripts/test-white2-streak.mjs",
    "test:remote:pairing": "node scripts/test-remote-multiplayer.mjs",
    "test:remote:radio": "node scripts/test-remote-radio.mjs",
    "test:white2:remote-native": "node scripts/test-white2-remote-native.mjs"
  },
  "dependencies": {
    "@thenick775/mgba-wasm": "2.5.1",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/emscripten": "^1.41.5",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
