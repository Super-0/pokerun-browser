{
  "name": "pokerun-browser",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-mgba-heap.mjs && vite",
    "dev:multiplayer": "node scripts/patch-mgba-heap.mjs && vite --host 0.0.0.0 --open=/multiplayer-dev.html",
    "build:melonds": "node scripts/build-melonds.mjs",
    "build": "node scripts/patch-mgba-heap.mjs && tsc -b && vite build",
    "preview": "node scripts/patch-mgba-heap.mjs && vite preview",
    "postinstall": "node scripts/patch-mgba-heap.mjs"
  },
  "dependencies": {
    "@thenick775/mgba-wasm": "2.5.1",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.5",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
